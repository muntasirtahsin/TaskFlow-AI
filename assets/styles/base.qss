/* TaskFlow AI base stylesheet. @tokens@ are replaced by ui/theme.py for light/dark themes. */
* { font-family: "Segoe UI Variable Text", "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif; font-size: 13px; outline: none; }
QWidget { color: @text@; }
QMainWindow, QDialog, QWidget#page, QWidget#root { background: @bg@; }
QWidget#transparent, QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; }
QScrollArea { border: none; }
QToolTip { background: @text@; color: @bg@; border: none; padding: 5px 8px; border-radius: 6px; }

/* ---- sidebar ---- */
QFrame#sidebar { background: @sidebar@; border-right: 1px solid @border@; }
QLabel#brand { font-size: 15px; font-weight: 700; letter-spacing: 0.2px; }
QLabel#brandMark { background: @accent@; border-radius: 9px; }
QPushButton#nav { text-align: left; padding: 8px 12px; border: none; border-radius: 8px; background: transparent; color: @muted@; font-weight: 500; }
QPushButton#nav:hover { background: @hover@; color: @text@; }
QPushButton#nav:checked { background: @accent_soft@; color: @accent@; font-weight: 600; }
QLabel#navSection { color: @faint@; font-size: 11px; font-weight: 600; padding: 10px 12px 4px 12px; }

/* ---- typography ---- */
QLabel#h1 { font-size: 22px; font-weight: 700; }
QLabel#h2 { font-size: 15px; font-weight: 650; }
QLabel#muted { color: @muted@; }
QLabel#faint { color: @faint@; font-size: 12px; }
QLabel#statValue { font-size: 26px; font-weight: 700; }
QLabel#statLabel { color: @muted@; font-size: 12px; font-weight: 500; }
QLabel#clock { font-size: 56px; font-weight: 300; }

/* ---- cards ---- */
QFrame#card { background: @surface@; border: 1px solid @border@; border-radius: 12px; }
QFrame#cardFlat { background: @surface2@; border: 1px solid @border@; border-radius: 10px; }
QFrame#divider { background: @border@; max-height: 1px; min-height: 1px; border: none; }
QFrame#banner { border-radius: 10px; border: 1px solid @border@; background: @surface2@; }

/* ---- buttons ---- */
QPushButton { padding: 6px 12px; border-radius: 8px; border: 1px solid @border@; background: @surface@; font-weight: 500; }
QPushButton:hover { background: @hover@; }
QPushButton:pressed { background: @pressed@; }
QPushButton:disabled { color: @faint@; background: @surface2@; }
QPushButton#primary { background: @accent@; color: @accent_text@; border: 1px solid @accent@; font-weight: 600; }
QPushButton#primary:hover { background: @accent_hover@; border-color: @accent_hover@; }
QPushButton#primary:disabled { background: @border@; border-color: @border@; color: @faint@; }
QPushButton#danger { color: @danger@; }
QPushButton#danger:hover { background: @danger_soft@; }
QPushButton#ghost { border: none; background: transparent; color: @muted@; }
QPushButton#ghost:hover { background: @hover@; color: @text@; }
QPushButton#iconBtn { border: none; background: transparent; padding: 6px; border-radius: 8px; }
QPushButton#iconBtn:hover { background: @hover@; }
QPushButton#seg { border-radius: 0; margin: 0; padding: 6px 14px; border: 1px solid @border@; background: @surface@; color: @muted@; }
QPushButton#seg:checked { background: @accent_soft@; color: @accent@; border-color: @accent@; font-weight: 600; }
QPushButton#chip { border-radius: 14px; padding: 4px 12px; background: @surface2@; color: @muted@; }
QPushButton#chip:checked { background: @accent_soft@; color: @accent@; border-color: @accent@; }

/* ---- inputs ---- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit, QDateTimeEdit {
    padding: 6px 9px; border: 1px solid @border@; border-radius: 8px; background: @surface@;
    selection-background-color: @accent@; selection-color: @accent_text@; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus { border: 1px solid @accent@; }
QLineEdit#quickAdd { padding: 10px 14px; border-radius: 10px; font-size: 14px; }
QLineEdit:disabled, QSpinBox:disabled, QDateTimeEdit:disabled, QDateEdit:disabled { color: @faint@; background: @surface2@; }
QComboBox::drop-down, QDateEdit::drop-down, QDateTimeEdit::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView { background: @surface@; border: 1px solid @border@; border-radius: 8px; selection-background-color: @accent_soft@; selection-color: @accent@; padding: 4px; outline: none; }
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button, QTimeEdit::up-button, QTimeEdit::down-button { width: 16px; border: none; background: transparent; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border-radius: 5px; border: 1px solid @faint@; background: @surface@; }
QCheckBox::indicator:checked { background: @accent@; border-color: @accent@; image: url(@check_icon@); }
QRadioButton::indicator { width: 14px; height: 14px; border-radius: 8px; border: 1px solid @faint@; }
QRadioButton::indicator:checked { background: @accent@; border-color: @accent@; }
QSlider::groove:horizontal { height: 4px; background: @border@; border-radius: 2px; }
QSlider::sub-page:horizontal { background: @accent@; border-radius: 2px; }
QSlider::handle:horizontal { width: 14px; height: 14px; margin: -5px 0; border-radius: 7px; background: @accent@; }

/* ---- lists & tables ---- */
QTableWidget, QTableView, QListWidget, QTreeWidget { background: @surface@; border: 1px solid @border@; border-radius: 10px; gridline-color: transparent; alternate-background-color: @surface@; selection-background-color: @accent_soft@; selection-color: @text@; }
QTableWidget::item { padding: 4px 8px; border-bottom: 1px solid @border@; }
QTableWidget::item:selected { background: @accent_soft@; color: @text@; }
QListWidget::item { padding: 7px 9px; border-radius: 7px; margin: 1px 4px; }
QListWidget::item:hover { background: @hover@; }
QListWidget::item:selected { background: @accent_soft@; color: @text@; }
QHeaderView { background: transparent; }
QHeaderView::section { background: @surface@; color: @muted@; border: none; border-bottom: 1px solid @border@; padding: 8px; font-weight: 600; font-size: 12px; }
QTableCornerButton::section { background: @surface@; border: none; }

/* ---- progress, tabs, scrollbars, menus ---- */
QProgressBar { border: none; background: @border@; border-radius: 3px; max-height: 6px; min-height: 6px; text-align: center; color: transparent; }
QProgressBar::chunk { background: @accent@; border-radius: 3px; }
QTabWidget::pane { border: none; }
QTabBar::tab { padding: 8px 14px; color: @muted@; border: none; border-bottom: 2px solid transparent; font-weight: 500; }
QTabBar::tab:selected { color: @accent@; border-bottom: 2px solid @accent@; }
QTabBar::tab:hover { color: @text@; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 2px; }
QScrollBar::handle:vertical { background: @scroll@; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: @faint@; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 2px; }
QScrollBar::handle:horizontal { background: @scroll@; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QMenu { background: @surface@; border: 1px solid @border@; border-radius: 10px; padding: 6px; }
QMenu::item { padding: 7px 22px 7px 12px; border-radius: 6px; }
QMenu::item:selected { background: @accent_soft@; color: @accent@; }
QMenu::separator { height: 1px; background: @border@; margin: 5px 8px; }
QGroupBox { border: 1px solid @border@; border-radius: 10px; margin-top: 12px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; color: @muted@; font-weight: 600; }
QMessageBox { background: @bg@; }
QStatusBar { background: @bg@; color: @muted@; }
